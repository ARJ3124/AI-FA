# FinFlow — Frontend Environment Variables
# Copy this file to .env and fill in your Supabase project credentials.
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API

# Supabase Project URL (e.g. https://abcdefghij.supabase.co)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Supabase Anon/Public Key (safe to expose — RLS handles security)
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
